<!--
    API-scope policy for the coupon service. Applies to every operation.

    Three jobs:

      1. CORS for the static frontend, so the browser can call the gateway directly.
      2. A correlation ID, stamped on the way in and returned on the way out, so one
         request can be followed from the gateway into the application's log lines
         (approach.md §9).
      3. Authenticating to the backend as the gateway's managed identity, which is the
         half of the trust relationship that makes the App Service unreachable except
         through here (approach.md §5).

    Placeholders are __NAME__ and are substituted by Bicep at deploy time. They are not
    {{NAME}}: double braces are APIM's own named-value syntax and a policy containing an
    unresolvable named value is rejected when it is saved, not when it is called. Rule 10.
-->
<policies>
    <inbound>
        <base />

        <!--
            CORS sits at API scope rather than operation scope on purpose. A preflight
            OPTIONS request carries no subscription key and matches no operation; APIM
            only answers it if the cors policy is at API scope or above.
        -->
        <cors allow-credentials="false">
            <allowed-origins>
                <origin>__FRONTEND_ORIGIN__</origin>
                <!--
                    Local development. Kept alongside the deployed origin rather than
                    replaced by it — the same rule that applies to the Entra redirect
                    URIs, and for the same reason: losing it costs a day of local work
                    to rediscover. See docs/decisions.md.
                -->
                <origin>__LOCAL_DEV_ORIGIN__</origin>
            </allowed-origins>
            <allowed-methods preflight-result-max-age="300">
                <method>GET</method>
                <method>POST</method>
                <method>OPTIONS</method>
            </allowed-methods>
            <allowed-headers>
                <header>Content-Type</header>
                <header>Authorization</header>
                <header>Ocp-Apim-Subscription-Key</header>
                <header>x-correlation-id</header>
            </allowed-headers>
            <!--
                Without this the browser can see the header on the wire but JavaScript
                cannot read it, so a frontend could never quote the correlation ID in a
                bug report.
            -->
            <expose-headers>
                <header>x-correlation-id</header>
            </expose-headers>
        </cors>

        <!--
            Keep the caller's correlation ID if they sent one, mint one from the
            gateway's own request ID otherwise. Minting unconditionally would break a
            caller that is already correlating across several services.

            Single-quoted attribute on purpose: the expression contains C# string
            literals, and double quotes inside a double-quoted XML attribute are not
            well-formed. XML permits either quoting style; APIM accepts both.
        -->
        <set-variable name="correlationId" value='@{
            var incoming = context.Request.Headers.GetValueOrDefault("x-correlation-id", string.Empty);
            return string.IsNullOrWhiteSpace(incoming) ? context.RequestId.ToString() : incoming;
        }' />
        <set-header name="x-correlation-id" exists-action="override">
            <value>@((string)context.Variables["correlationId"])</value>
        </set-header>

        <!--
            Stash the caller's own bearer token before the next policy overwrites it.

            This exists because of an ordering constraint that is easy to get wrong and
            expensive when you do. `authentication-managed-identity` replaces the
            Authorization header with the gateway's own token, and it can only run in
            inbound. Inbound sections run outermost-first — API scope before operation
            scope — so it necessarily runs BEFORE the operation-scope validate-jwt that
            phase D puts on POST /orders.

            If validate-jwt then read the Authorization header, it would be validating
            the gateway's own token rather than the customer's. It would pass. An order
            endpoint that accepts every request while reporting successful token
            validation is the worst available version of that bug, and no smoke test
            would catch it.

            So the caller's token is captured here and phase D's policy reads it with
            validate-jwt's `token-value` attribute instead of `header-name`. The Bearer
            prefix is stripped because token-value must not include it.

            An empty value is correct and deliberate for a caller that sent no token:
            validate-jwt fails it with the configured 401.
        -->
        <set-variable name="callerToken" value='@{
            var auth = context.Request.Headers.GetValueOrDefault("Authorization", string.Empty);
            return auth.StartsWith("Bearer ", System.StringComparison.OrdinalIgnoreCase)
                ? auth.Substring(7).Trim()
                : string.Empty;
        }' />

        <!--
            Authenticate to the backend. Sets the Authorization header to a token for
            coupon-api obtained as the gateway's user-assigned identity — which is the
            identity named in the App Service's Easy Auth allowedApplications, and the
            only one it accepts.

            client-id is required because the identity is user-assigned: without it the
            policy asks for a system-assigned identity that does not exist.

            This must be the last thing in inbound at this scope.
        -->
        <authentication-managed-identity resource="__BACKEND_RESOURCE__" client-id="__GATEWAY_CLIENT_ID__" ignore-error="false" />
    </inbound>

    <backend>
        <!--
            Left as the inherited default forwarding. The backend section accepts exactly
            one policy, so nothing can be added alongside <base />.
        -->
        <base />
    </backend>

    <outbound>
        <base />
        <set-header name="x-correlation-id" exists-action="override">
            <value>@((string)context.Variables["correlationId"])</value>
        </set-header>
    </outbound>

    <on-error>
        <base />
        <!--
            A failure in inbound can happen before the variable is set, so this cannot
            assume it exists. Returning the ID on the error path is the case that matters
            most: it is the response somebody will be asking about.
        -->
        <set-header name="x-correlation-id" exists-action="override">
            <value>@(context.Variables.ContainsKey("correlationId") ? (string)context.Variables["correlationId"] : context.RequestId.ToString())</value>
        </set-header>
    </on-error>
</policies>
