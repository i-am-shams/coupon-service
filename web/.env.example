# Copy to .env.local for local development. .env.local is gitignored.
#
# In the pipeline these come from Bicep outputs and pipeline variables and are passed
# to `npm run build` as environment variables. Nothing here is a credential:
#
#   VITE_SUBSCRIPTION_KEY is an APIM subscription key. It is compiled into a public
#   bundle and is readable by anyone who opens developer tools. That is understood and
#   accepted — the key is a client identifier and a rate-limit handle, not a credential,
#   and the only mutating endpoint is protected by something that is not the key.
#   See docs/decisions.md.

VITE_GATEWAY_URL=https://apim-couponsvc-lab-xxxxxx.azure-api.net
VITE_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/Orders.Write
VITE_SUBSCRIPTION_KEY=replace-me
